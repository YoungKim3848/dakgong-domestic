@@ -308,3 +308,208 @@ table.dk-table tbody tr:nth-child(even) th { background: var(--dk-surface-elevat
 .dk-ds__rows dd { padding: 4px 0 12px; border-top: 0; }
 .dk-ds__rows dt:first-of-type { padding-top: 0; }
 }
+
+/* ══════════════════════════════════════════════════════════════
+   사진 갤러리 (.dk-gal) — 헤더줄 + 벤토 격자 + 불렛
+   ──────────────────────────────────────────────────────────────
+   2026-08-16 — page-life-care.css 에서 이곳으로 승격. 값은 한 글자도 안 바꿨고
+   선택자 접두사만 .page-life-care-gal → .dk-gal 로 바꿨다.
+
+   왜 옮겼나 — 활동사진을 넣으면서 자리표시 컴포넌트(.dk-ph-*)를 그대로 썼더니
+   PC 에서 사진 블록만 안쪽 오른쪽에 몰려(x=470) 위 섹션들(x=80)과 선이 안 맞았다.
+   글칸 여백을 네 번 고쳐도 정렬은 안 고쳐졌다. 회장 지시로 **이미 승인된
+   시설 갤러리 문법으로 통일**한다 — 헤더줄·격자·불렛이 전부 폭을 꽉 채워
+   구멍이 안 생기고 위 섹션들과 선이 맞는다.
+
+   ⚠️ 옮기면서 로드 순서가 page-* 뒤 → _components 로 앞당겨졌다.
+      생활환경 화면이 안 변했는지 snapshot.py 로 대조하고 넣었다.
+══════════════════════════════════════════════════════════════ */
+/* ══════════════════════════════════════════════════════════════
+   시설 갤러리 — 필핀 시설 페이지(facility.imweb.html) 01~05 골격 이식
+   2026-08-03 회장 지시. 형태는 필핀 그대로, 색만 국내 코발트로 치환한다.
+
+   · 배열 4종(p0·p2·p3·p4)을 섹션마다 다르게 쓴다. 바깥 상자(폭·높이·간격)는 전부 같아
+     스크롤 리듬은 유지되고 섹션마다 얼굴만 달라진다.
+   · 변주에 근거를 둔다 — 사진이 노출분보다 많은 섹션(전경 11장)에만 「전체 보기」 버튼이
+     붙고, 4장짜리는 다 보이므로 버튼 대신 사진이 그 칸을 채운다.
+   · 전역에 두는 클래스는 `.dk-gal` 하나뿐. 나머지는 그 안으로 스코프한다
+     (공통 이름공간 침범 금지 + 요소 기본값 `.dk h3`(0,1,1) 를 이기는 특성도 확보).
+   ══════════════════════════════════════════════════════════════ */
+.dk .dk-gal--alt { background: var(--dk-surface-card); }
+.dk-gal .fac + .fac { margin-top: var(--dk-gap-xl); }
+
+.dk-gal .hd { display: flex; align-items: center; gap: 14px; margin: 0 0 28px; }
+.dk-gal .hd .no { font-size: 15px; font-weight: 400; color: var(--dk-accent-red);
+  flex-shrink: 0; font-variant-numeric: tabular-nums; }
+.dk .dk-gal .hd .nm { font-family: var(--dk-font-display); font-size: 36px;
+  font-weight: 700; line-height: 1.25; margin: 0; flex-shrink: 0; color: var(--dk-ink); }
+.dk-gal .hd .rule { flex: 1; height: 1px; background: var(--dk-hairline); }
+.dk-gal .hd .cnt { font-size: 13px; font-weight: 700; color: var(--dk-fg-muted);
+  flex-shrink: 0; font-variant-numeric: tabular-nums; }
+
+.dk-gal .bento { display: grid; grid-template-columns: 1.5fr 1fr 1fr;
+  grid-template-rows: 260px 200px; gap: 8px; }
+.dk-gal .b { border-radius: var(--dk-radius-md); overflow: hidden; position: relative;
+  background: var(--dk-surface-elevated); cursor: zoom-in;
+  display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 6px; }
+.dk-gal .b img { width: 100%; height: 100%; object-fit: cover; display: block;
+  transition: transform .35s cubic-bezier(.2,.7,.2,1); }
+.dk-gal .b:hover img { transform: scale(1.04); }
+.dk-gal .b > svg { width: 22px; height: 22px; stroke: var(--dk-fg-muted);
+  fill: none; stroke-width: 1.6; }
+.dk .dk-gal .b .t { font-size: 12.5px; font-weight: 700; color: var(--dk-fg-2); margin: 0; }
+.dk .dk-gal .b .s { font-size: 11px; color: var(--dk-fg-muted); margin: 0; }
+.dk-gal .b.wait { background: repeating-linear-gradient(45deg,
+  var(--dk-surface-elevated), var(--dk-surface-elevated) 9px,
+  var(--dk-surface-soft) 9px, var(--dk-surface-soft) 18px);
+  outline: 2px dashed var(--dk-warning-ink); outline-offset: -6px; }
+.dk .dk-gal .b.wait .t { color: var(--dk-warning-ink); }
+
+.dk-gal .more { grid-column: 3; grid-row: 2; border: none; padding: 0;
+  border-radius: var(--dk-radius-md); background: var(--dk-ink); cursor: pointer;
+  font-family: inherit; transition: background .2s;
+  display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 8px; }
+.dk-gal .more:hover { background: var(--dk-accent-red); }
+.dk-gal .more .c { font-size: 28px; font-weight: 800; color: #fff; line-height: 1;
+  font-variant-numeric: tabular-nums; }
+.dk-gal .more .l { font-size: 12px; font-weight: 600; color: rgba(255,255,255,.65);
+  letter-spacing: .5px; }
+
+.dk-gal .bul { display: flex; flex-wrap: wrap; gap: 6px 20px; margin: 20px 0 0; }
+.dk-gal .bul span { display: flex; align-items: center; gap: 7px;
+  font-size: 13px; color: var(--dk-fg-2); }
+.dk-gal .bul span::before { content: ""; width: 5px; height: 5px; border-radius: 50%;
+  background: var(--dk-accent-red); flex-shrink: 0; }
+
+/* ── 배열 4종 ── */
+.dk-gal .p0 .bm { grid-column: 1; grid-row: 1/3; }
+.dk-gal .p0 .b1 { grid-column: 2; grid-row: 1; }
+.dk-gal .p0 .b2 { grid-column: 3; grid-row: 1; }
+.dk-gal .p0 .b3 { grid-column: 2; grid-row: 2; }
+.dk-gal .p2 .bm { grid-column: 1; grid-row: 1/3; }
+.dk-gal .p2 .b1 { grid-column: 2; grid-row: 1; }
+.dk-gal .p2 .b2 { grid-column: 3; grid-row: 1; }
+.dk-gal .p2 .b3 { grid-column: 2/4; grid-row: 2; }
+.dk-gal .p3 { grid-template-rows: 250px 210px; }
+.dk-gal .p3 .bm { grid-column: 1/4; grid-row: 1; }
+.dk-gal .p3 .b1 { grid-column: 1; grid-row: 2; }
+.dk-gal .p3 .b2 { grid-column: 2; grid-row: 2; }
+.dk-gal .p3 .b3 { grid-column: 3; grid-row: 2; }
+.dk-gal .p4 .bm { grid-column: 3; grid-row: 1/3; }
+.dk-gal .p4 .b1 { grid-column: 1; grid-row: 1; }
+.dk-gal .p4 .b2 { grid-column: 2; grid-row: 1; }
+.dk-gal .p4 .b3 { grid-column: 1/3; grid-row: 2; }
+
+/* ── 모바일 — 배열마다 얼굴이 달라야 스크롤이 안 지겹다 ── */
+@media (max-width: 768px) {
+  .dk-gal .hd { gap: 10px; margin-bottom: 20px; }
+  .dk .dk-gal .hd .nm { font-size: 24px; }
+  .dk-gal .bento { grid-template-columns: 1fr 1fr; gap: 6px; }
+  .dk-gal .p0 { grid-template-rows: 52vw 34vw 34vw; }
+  .dk-gal .p0 .bm { grid-column: 1/3; grid-row: 1; }
+  .dk-gal .p0 .b1 { grid-column: 1; grid-row: 2; }
+  .dk-gal .p0 .b2 { grid-column: 2; grid-row: 2; }
+  .dk-gal .p0 .b3 { grid-column: 1; grid-row: 3; }
+  .dk-gal .p0 .more { grid-column: 2; grid-row: 3; }
+  .dk-gal .p2 { grid-template-rows: 52vw 34vw 34vw; }
+  .dk-gal .p2 .bm { grid-column: 1/3; grid-row: 1; }
+  .dk-gal .p2 .b1 { grid-column: 1; grid-row: 2; }
+  .dk-gal .p2 .b2 { grid-column: 2; grid-row: 2; }
+  .dk-gal .p2 .b3 { grid-column: 1/3; grid-row: 3; }
+  .dk-gal .p3 { grid-template-rows: 34vw 34vw 44vw; }
+  .dk-gal .p3 .bm { grid-column: 1; grid-row: 1/3; }
+  .dk-gal .p3 .b1 { grid-column: 2; grid-row: 1; }
+  .dk-gal .p3 .b2 { grid-column: 2; grid-row: 2; }
+  .dk-gal .p3 .b3 { grid-column: 1/3; grid-row: 3; }
+  .dk-gal .p4 { grid-template-rows: 34vw 34vw 52vw; }
+  .dk-gal .p4 .b1 { grid-column: 1; grid-row: 1; }
+  .dk-gal .p4 .b2 { grid-column: 2; grid-row: 1; }
+  .dk-gal .p4 .b3 { grid-column: 1/3; grid-row: 2; }
+  .dk-gal .p4 .bm { grid-column: 1/3; grid-row: 3; }
+}
+
+/* ── 확대창 ── 이름을 갤러리 전용으로 분리한다.
+   슬롯 라벨과 같은 이름을 쓰면 `position:fixed; display:none` 이 라벨을 덮어 글자가 사라진다.
+   이름 겹침은 특성도로 막히지 않는다 — 상대가 선언하지 않은 속성은 그대로 먹기 때문이다.
+   (2026-08-03 프리뷰 제작 중 실제로 밟은 버그) */
+.dk-galbox { position: fixed; inset: 0; background: rgba(12,14,18,.94); z-index: 60;
+  display: none; align-items: center; justify-content: center; padding: 56px 16px; }
+.dk-galbox.is-on { display: flex; }
+.dk-galbox__fig { max-width: 1000px; width: 100%; text-align: center; margin: 0; }
+.dk-galbox__img { background: #333; border-radius: var(--dk-radius-md); aspect-ratio: 4/3;
+  display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 8px; }
+.dk .dk-galbox__img .t { font-size: 15px; font-weight: 700; color: #efefef; margin: 0; }
+.dk .dk-galbox__img .s { font-size: 12.5px; color: var(--dk-fg-muted); margin: 0; }
+.dk .dk-galbox__cap { margin: 14px 0 0; color: #efefef; font-size: 14px; font-weight: 700; }
+.dk .dk-galbox__idx { margin: 4px 0 0; color: var(--dk-fg-cool-soft); font-size: 12.5px;
+  font-variant-numeric: tabular-nums; }
+.dk-galbox__x, .dk-galbox__nav { position: absolute; background: rgba(255,255,255,.12); border: none;
+  color: #fff; border-radius: 50%; cursor: pointer; font: inherit;
+  display: flex; align-items: center; justify-content: center; }
+.dk-galbox__x { top: 16px; right: 16px; width: 40px; height: 40px; font-size: 20px; }
+.dk-galbox__nav { top: 50%; transform: translateY(-50%); width: 46px; height: 46px; font-size: 22px; }
+.dk-galbox__nav.is-prev { left: 16px; }
+.dk-galbox__nav.is-next { right: 16px; }
+.dk-galbox__x:hover, .dk-galbox__nav:hover { background: rgba(255,255,255,.22); }
+.dk-galbox__x:focus-visible, .dk-galbox__nav:focus-visible {
+  outline: 2px solid var(--dk-accent-onDark); outline-offset: 2px; }
+
+/* ══════════════════════════════════════════════════════════════
+   ★2026-08-16 — 칸 비율을 원본 사진(1.50:1)에 묶는다  (회장 지시)
+   ──────────────────────────────────────────────────────────────
+   종전 격자는 행 높이를 260px/200px 로 **고정**하고 칸 폭만 1~3열로 달랐다.
+   그래서 칸 비율이 0.37:1 ~ 4.92:1 까지 벌어졌고, object-fit:cover 로
+   **사진이 25~30% 만 남는 칸**이 생겼다(인물 사진은 얼굴이 잘려 나간다).
+
+   ⚠️ 자리표시(빈 회색 상자)일 땐 이게 안 보인다. 실물 사진이 들어가야 드러난다.
+      승인 시점에 사진이 없었으므로 "승인된 배열"이 곧 "승인된 비율"은 아니었다.
+
+   고치는 방식 — 고정 높이를 버리고 **컨테이너에 aspect-ratio** 를 건다.
+   폭이 변해도 모든 칸의 비율이 그대로 유지된다.
+   허용 범위 1.15 ~ 1.95 → 사진이 최소 77% 남는다.
+   크기 리듬은 **높이가 아니라 열 폭**으로 만든다.
+══════════════════════════════════════════════════════════════ */
+
+/* 4칸 기본 — 2열 × 2행. 왼쪽 열이 1.5배 넓다(1.80:1) / 오른쪽(1.20:1) */
+.dk-gal .bento { grid-template-columns: 1.5fr 1fr; grid-template-rows: 1fr 1fr;
+  aspect-ratio: 1280 / 848; gap: 8px; }
+.dk-gal .p2 .bm, .dk-gal .p3 .bm, .dk-gal .p4 .bm { grid-column: 1; grid-row: 1; }
+.dk-gal .p2 .b1, .dk-gal .p3 .b1, .dk-gal .p4 .b1 { grid-column: 2; grid-row: 1; }
+.dk-gal .p2 .b2, .dk-gal .p3 .b2, .dk-gal .p4 .b2 { grid-column: 1; grid-row: 2; }
+.dk-gal .p2 .b3, .dk-gal .p3 .b3, .dk-gal .p4 .b3 { grid-column: 2; grid-row: 2; }
+/* 넓은 열을 좌우로 바꿔 리듬을 준다. 비율은 그대로 1.80 / 1.20 이다. */
+.dk-gal .p3 .bento { grid-template-columns: 1fr 1.5fr; }
+.dk-gal .p3 .bm { grid-column: 2; grid-row: 1; }
+.dk-gal .p3 .b1 { grid-column: 1; grid-row: 1; }
+.dk-gal .p3 .b2 { grid-column: 2; grid-row: 2; }
+.dk-gal .p3 .b3 { grid-column: 1; grid-row: 2; }
+/* 큰 칸을 아래로 내린 변형 */
+.dk-gal .p4 .bm { grid-column: 1; grid-row: 2; }
+.dk-gal .p4 .b2 { grid-column: 1; grid-row: 1; }
+
+/* 5칸 (사진 4 + 「전체 보기」 버튼) — 4열 × 2행. 큰 칸이 2열 2행을 먹는다.
+   큰 칸 1.50:1 · 작은 칸 1.51:1 로 전부 원본과 거의 같다. */
+/* ⚠️ 격자 지정은 .fac 이 아니라 자식 .bento 에 걸어야 한다.
+   .fac 에 걸면 조용히 안 먹고, 자식에 준 grid-column 이 없는 열을 가리켜
+   암시적 열이 생기면서 칸이 8px 로 찌그러진다(2026-08-16 실제로 당함). */
+.dk-gal .p0 .bento { grid-template-columns: repeat(4, 1fr); grid-template-rows: 1fr 1fr;
+  aspect-ratio: 1280 / 424; }
+.dk-gal .p0 .bm { grid-column: 1 / 3; grid-row: 1 / 3; }
+.dk-gal .p0 .b1 { grid-column: 3; grid-row: 1; }
+.dk-gal .p0 .b2 { grid-column: 4; grid-row: 1; }
+.dk-gal .p0 .b3 { grid-column: 3; grid-row: 2; }
+.dk-gal .p0 .more { grid-column: 4; grid-row: 2; }
+
+/* 태블릿·폰 — 2열 유지. 폭이 좁아져도 aspect-ratio 라 비율은 안 변한다. */
+@media (max-width: 640px) {
+  /* 폰에서 2열로 두면 칸이 172×115 까지 작아진다. 1열로 세우고 칸마다 3:2 를 건다.
+     비율을 컨테이너가 아니라 칸에 걸면 갯수가 달라져도 안 깨진다. */
+  .dk-gal .bento, .dk-gal .p0 .bento, .dk-gal .p3 .bento {
+    grid-template-columns: 1fr; grid-template-rows: none;
+    grid-auto-rows: auto; aspect-ratio: auto; gap: 8px; }
+  .dk-gal .p0 > *, .dk-gal .p2 > *, .dk-gal .p3 > *, .dk-gal .p4 > *,
+  .dk-gal .p0 .bento > *, .dk-gal .p2 .bento > *, .dk-gal .p3 .bento > *, .dk-gal .p4 .bento > * {
+    grid-column: auto; grid-row: auto; }
+  .dk-gal .b { aspect-ratio: 3 / 2; }
+  .dk-gal .more { min-height: 72px; }
+}
